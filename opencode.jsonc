{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "devenv-docs": {
      "type": "local",
      "command": ["uv", "run", "python", "-m", "docs_server.server"],
      "cwd": "mcp/docs-server",
      "enabled": true
    },
    "devenv-lab-sim": {
      "type": "remote",
      "url": "http://127.0.0.1:8300/mcp/",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:LAB_SIM_AGENT_TOKEN}"
      },
      "enabled": true
    }
  }
}
