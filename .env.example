# Copy to .env and adjust before running `make up`.

# Coder image tag (pinned).
CODER_VERSION=v2.36.3

# Host port that exposes the Coder web UI / API.
CODER_HTTP_PORT=7080

# External URL used by users and workspaces to reach Coder. Must not be
# localhost/127.0.0.1 once workspaces need to reach it from elsewhere.
CODER_ACCESS_URL=http://localhost:7080

# gid of the host's "docker" group, so the coder container can write to the
# mounted /var/run/docker.sock. Get it with: getent group docker | cut -d: -f3
DOCKER_GID=998

# PostgreSQL credentials for the coder-db service.
CODER_PG_USER=coder
CODER_PG_PASSWORD=coder
CODER_PG_DB=coder

# Optional: only set this after running `scripts/coder-trust-ca.sh`, on a
# corporate TLS-intercepting proxy where the coder container's own
# `terraform init` can't verify registry.terraform.io. Leave unset/empty
# on unrestricted networks (no-op). See README "Corporate
# TLS-intercepting proxy: trusting a CA for Coder itself".
CODER_SSL_CERT_DIR=

# Temporal image tags (pinned, Milestone M8).
TEMPORAL_VERSION=1.29.7
TEMPORAL_UI_VERSION=2.53.3

# Host ports for Temporal's gRPC frontend and Web UI.
TEMPORAL_GRPC_PORT=7233
TEMPORAL_UI_PORT=8088

# PostgreSQL credentials for the temporal-db service.
TEMPORAL_PG_USER=temporal
TEMPORAL_PG_PASSWORD=temporal
TEMPORAL_PG_DB=temporal

# Host port (127.0.0.1-only) for the M11 Lab Simulator MCP/HTTP service.
LAB_SIM_PORT=8300

# Comma-separated caller_id:token pairs authorized to call the lab-sim
# service (Milestone M11). Change these before any non-local use - every
# caller's reservations are bound to the caller_id resolved from its own
# token, so distinct real callers need distinct tokens here.
LAB_SIM_TOKENS=agent-a:change-me-a,agent-b:change-me-b

# Milestone M15: bearer token the temporal-worker container presents to
# lab-sim when running EmbeddedValidationWorkflow's Activities - must be
# one of the caller_id:token pairs in LAB_SIM_TOKENS above (defaults to
# the "agent-a" pair already listed there).
LAB_SIM_AGENT_TOKEN=change-me-a

# Host port (127.0.0.1-only) for the M12 OPA decision-API service.
OPA_PORT=8181

# Host port (127.0.0.1-only) for the M12 OpenBao secrets store (TLS,
# self-signed cert generated by scripts/openbao-gen-cert.sh).
OPENBAO_PORT=8200

# Keycloak (M12, OPTIONAL) - only used when running
# `docker compose --profile governance up`. Set to a generated/rotated
# value before enabling; Keycloak refuses to boot without one.
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_PORT=8543

# Grafana (M13 Observability) - admin password for the local dashboard UI
# and the host port (127.0.0.1-only) it's published on. Change before any
# non-local use.
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3001

# GitHub external auth provider (Task 0, issue #13). Create a GitHub OAuth
# App manually (out of scope for automation), then UNCOMMENT the
# CODER_EXTERNAL_AUTH_0_* block in compose.yaml's `coder` service and set
# these two values. Verified live: Coder crashes at startup if that block
# is active with these left empty (the env var's mere presence, not its
# value, triggers provider parsing) — so it stays commented out in
# compose.yaml by default and these two keys are inert until you do both
# steps. Leaving it disabled only affects the CI-triggered agent path.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- Coder AI (Agents / providers / MCP) ---------------------------------
# Experiments enabling the remote Coder MCP server. Leave as-is unless you
# know why you are changing it.
CODER_EXPERIMENTS=oauth2,mcp-server-http

# Admin session token used ONLY by `make ai-bootstrap` to reconcile
# coder/ai/*.yaml into the Coder deployment. Mint one with `make ai-token`.
# Without it, AI bootstrap is skipped and `make up` still succeeds.
CODER_SESSION_TOKEN=

# LLM provider key referenced by coder/ai/providers.yaml (api_key_env).
# Never commit a real value. Leave empty to skip that provider.
OPENAI_API_KEY=

# --- Omnigent server (Issue #43 Step 1) -----------------------------------
# Shared, singleton Omnigent server (github.com/omnigent-ai/omnigent,
# pinned v0.11.0) + its own Postgres. See compose.yaml's omnigent-db /
# omnigent-server services.

# PostgreSQL credentials for the omnigent-db service.
OMNIGENT_PG_USER=omnigent
OMNIGENT_PG_PASSWORD=omnigent
OMNIGENT_PG_DB=omnigent

# Host port (127.0.0.1-only) the omnigent-server web UI/API is published on.
OMNIGENT_PORT=8000

# Public base URL where users/browsers reach the server - MUST be the URL
# the browser sees, not the internal omnigent-server:8000 compose address.
# Change if this stack is ever reachable through anything other than
# http://localhost:8000.
OMNIGENT_ACCOUNTS_BASE_URL=http://localhost:8000

# 32-byte hex cookie secrets. Generate with: openssl rand -hex 32
# Required once real (non-local) auth is exercised - see upstream
# deploy/docker/.env.example (tbrandenburg/omnigent-sandbox) for the full
# accounts vs. OIDC walkthrough.
OMNIGENT_ACCOUNTS_COOKIE_SECRET=
OMNIGENT_OIDC_COOKIE_SECRET=

# First-admin bootstrap password (accounts auth mode). omnigent-server reads
# this directly at its own boot time to create the "admin" account - set it
# before first `docker compose up -d omnigent-server`, then run
# `make omnigent-bootstrap` / `scripts/openbao-init.sh` to seed the matching
# OpenBao secret workspaces use to log in. Leave empty to set the first
# admin up manually via the web UI instead.
OMNIGENT_ACCOUNTS_INIT_ADMIN_PASSWORD=



