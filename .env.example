# Copy to .env and adjust before running `make up`.

# Coder image tag (pinned).
CODER_VERSION=v2.36.3

# Host port that exposes the Coder web UI / API.
CODER_HTTP_PORT=7080

# External URL used by users and workspaces to reach Coder. Must not be
# localhost/127.0.0.1 once workspaces need to reach it from elsewhere.
CODER_ACCESS_URL=http://localhost:7080

# gid of the host's "docker" group, so the coder container can write to the
# mounted /var/run/docker.sock. Get it with: getent group docker | cut -d: -f3
DOCKER_GID=998

# PostgreSQL credentials for the coder-db service.
CODER_PG_USER=coder
CODER_PG_PASSWORD=coder
CODER_PG_DB=coder

# Temporal image tags (pinned, Milestone M8).
TEMPORAL_VERSION=1.29.7
TEMPORAL_UI_VERSION=2.53.3

# Host ports for Temporal's gRPC frontend and Web UI.
TEMPORAL_GRPC_PORT=7233
TEMPORAL_UI_PORT=8088

# PostgreSQL credentials for the temporal-db service.
TEMPORAL_PG_USER=temporal
TEMPORAL_PG_PASSWORD=temporal
TEMPORAL_PG_DB=temporal

# Host port (127.0.0.1-only) for the M11 Lab Simulator MCP/HTTP service.
LAB_SIM_PORT=8300

# Comma-separated caller_id:token pairs authorized to call the lab-sim
# service (Milestone M11). Change these before any non-local use - every
# caller's reservations are bound to the caller_id resolved from its own
# token, so distinct real callers need distinct tokens here.
LAB_SIM_TOKENS=agent-a:change-me-a,agent-b:change-me-b

# Host port (127.0.0.1-only) for the M12 OPA decision-API service.
OPA_PORT=8181

# Host port (127.0.0.1-only) for the M12 OpenBao secrets store (TLS,
# self-signed cert generated by scripts/openbao-gen-cert.sh).
OPENBAO_PORT=8200

# Keycloak (M12, OPTIONAL) - only used when running
# `docker compose --profile governance up`. Set to a generated/rotated
# value before enabling; Keycloak refuses to boot without one.
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_PORT=8543

# Grafana (M13 Observability) - admin password for the local dashboard UI
# and the host port (127.0.0.1-only) it's published on. Change before any
# non-local use.
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3001



